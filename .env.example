# ---- ICA gateway ----------------------------------------------------------
# Base URL of the ICA API, including the version path.
ICA_BASE_URL=https://api.servicesessentials.ibm.com/v1

# API key / token.
ICA_API_KEY=replace-me

# Header used to carry the credential. The IBM ICA gateway uses a bare
# `X-API-Key` and rejects `Authorization: Bearer`.
ICA_AUTH_HEADER=X-API-Key

# Set to `true` only for gateways using `Authorization: Bearer <key>`.
ICA_USE_BEARER_PREFIX=false

# Comma-separated models to monitor. If omitted, the app calls GET /v1/models
# and probes everything the gateway advertises (19 models as of writing, which
# makes each probe round slower and more expensive). Pinning an explicit list is
# recommended.
ICA_MODELS=gpt-5.1,claude-sonnet-5,gemini-3.7-flash,ibm/granite-4-h-small

# Prompt sent on each probe.
ICA_PROBE_PROMPT=Reply with the single word: ok

# Output token budget per probe. Keep this high enough for reasoning models:
# some gemini models spend 50-105 tokens thinking before emitting any text, and
# a low cap truncates them into an empty reply that looks like an outage.
ICA_PROBE_MAX_TOKENS=512

# Per-request timeout in milliseconds. The slowest healthy model observed on the
# ICA gateway took ~55s, so keep this comfortably above that.
ICA_PROBE_TIMEOUT_MS=90000

# ---- Database -------------------------------------------------------------
# Neon Postgres connection string (use the pooled URL).
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---- Scheduling -----------------------------------------------------------
# Shared secret protecting /api/probe. Generate with: openssl rand -hex 32
CRON_SECRET=replace-me
